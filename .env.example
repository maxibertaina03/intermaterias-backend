PORT=3000

# URL del front: CORS solo acepta peticiones desde acá
FRONTEND_URL=http://localhost:5173

# Login con Clerk (https://dashboard.clerk.com → API Keys). Se pasan por privado: NUNCA subirlas.
# Si quedan vacías, el backend funciona en modo desarrollo con DEV_ID_USUARIO.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Desarrollo: id del usuario con el que se trabaja mientras no está el login.
# 1 = Sofía (Eventos del Centro, atención + propuesta) · 2 = Mateo (organización) · 3 = Valentina (integrante)
DEV_ID_USUARIO=1

# Motor de base de datos: postgres (por ahora). Más adelante: mongo
DB_CLIENT=postgres
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/nombre_db

# PostgreSQL en Neon (base compartida del grupo).
# Los datos reales se pasan por privado: NUNCA subirlos a GitHub.
DB_HOST=ep-xxxx.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=eventos_owner
DB_PASSWORD=pedir_al_grupo
DB_NAME=eventos
DB_SSL=true

# Para usar una base local (Postgres instalado o docker compose):
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=su_contraseña
# DB_SSL=false
