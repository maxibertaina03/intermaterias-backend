PORT=3000

# Motor de base de datos: postgres (por ahora). Más adelante: mongo
DB_CLIENT=postgres

# PostgreSQL en Neon (base compartida del grupo).
# Los datos reales se pasan por privado: NUNCA subirlos a GitHub.
DB_HOST=ep-xxxx.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=eventos_owner
DB_PASSWORD=pedir_al_grupo
DB_NAME=eventos
DB_SSL=true

# Para usar una base local (Postgres instalado o docker compose):
