Ref:"empresas"."id_empresa" < "eventos"."id_empresa"

Ref:"clientes"."id_cliente" < "eventos"."id_cliente"

Ref:"contactos"."id_contacto" < "eventos"."id_contacto"

Ref:"tipos_evento"."id_tipo_evento" < "eventos"."id_tipo_evento"

Ref:"sedes"."id_sede" < "eventos"."id_sede"

Ref:"eventos"."id_evento" < "evento_cursos"."id_evento"

Ref:"cursos"."id_curso" < "evento_cursos"."id_curso"

Ref:"empresas"."id_empresa" < "propuestas"."id_empresa"

Ref:"eventos"."id_evento" - "propuestas"."id_evento"

Ref:"propuestas"."id_propuesta" < "propuesta_items"."id_propuesta"

Ref:"servicios"."id_servicio" < "propuesta_items"."id_servicio"

Ref:"eventos"."id_evento" < "evento_servicios"."id_evento"

Ref:"servicios"."id_servicio" < "evento_servicios"."id_servicio"

Ref:"proveedores"."id_proveedor" < "evento_servicios"."id_proveedor"

Ref:"usuarios"."id_usuario" < "evento_servicios"."id_responsable"

Ref:"empresas"."id_empresa" < "tareas"."id_empresa"

Ref:"eventos"."id_evento" < "tareas"."id_evento"

Ref:"usuarios"."id_usuario" < "tareas"."id_responsable"

Ref:"eventos"."id_evento" < "cambios_evento"."id_evento"

Ref:"usuarios"."id_usuario" < "cambios_evento"."id_usuario"

